# Settings of docker-compose.standalone.yml: copy to .env in the same folder and adjust.
# The two database passwords are required. Lines left commented out keep the built-in defaults.

# --- Image ---
# Released version (the git tag without "v", e.g. 0.1.0) or latest. Pin a version in production.
RUTERA_VERSION=latest
# Another registry or a local build (docker build -t rutera:local . -> RUTERA_IMAGE=rutera, RUTERA_VERSION=local)
# RUTERA_IMAGE=ghcr.io/vlslysenko/rutera

# --- Network ---
# Host port of RUTERA; keep it outside 8080-8089, often taken by other services.
RUTERA_PORT=18090
# 127.0.0.1 when only a reverse proxy on the same host may reach RUTERA.
RUTERA_BIND_ADDRESS=0.0.0.0
# true behind HTTPS (reverse proxy): the session cookie is then sent over HTTPS only.
RUTERA_COOKIE_SECURE=false
# Public address as users and claude.ai reach it, e.g. https://rutera.example.com (needed for the claude.ai
# connector behind a reverse proxy: OAuth issuer and published URLs).
RUTERA_PUBLIC_URL=
# Time zone of the logs and of the backup schedule (the database always keeps UTC).
RUTERA_TZ=Europe/Warsaw
# JVM options, e.g. -Xmx1g (default: 75% of the memory the container may use)
RUTERA_JAVA_OPTS=

# --- Database (applied when the MySQL volume is created; later changes need ALTER USER in MySQL too) ---
RUTERA_DB_NAME=rutera
RUTERA_DB_USER=rutera
RUTERA_DB_PASSWORD=
RUTERA_DB_ROOT_PASSWORD=

# --- First start on the empty database: the first firma and its owner account ---
# Empty password: a random one is generated and printed in the log once (change it after signing in).
RUTERA_BOOTSTRAP_FIRMA_NAME=My company
RUTERA_BOOTSTRAP_FIRMA_COUNTRY=PL
RUTERA_BOOTSTRAP_LANG=en
RUTERA_BOOTSTRAP_ADMIN_LOGIN=admin
RUTERA_BOOTSTRAP_ADMIN_PASSWORD=
RUTERA_BOOTSTRAP_ADMIN_NAME=Administrator

# --- Paid options, written to the firma at every start (empty = keep what the database has) ---
# AI access add-on: public API (/api/v1), MCP server and the claude.ai connector (true or false)
# RUTERA_AI_ACCESS=true
# RUTERA_PLAN=STANDARD
# RUTERA_VEHICLE_LIMIT=30

# --- E-mail (payment reminders). Without SPRING_MAIL_HOST the e-mails wait in the outbox. ---
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=rutera@example.com
# SPRING_MAIL_PASSWORD=
# Port 587: STARTTLS; port 465: SSL instead.
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
# Sender address (default: the SMTP user name) and name
# RUTERA_MAIL_FROM=rutera@example.com
# RUTERA_MAIL_FROM_NAME=RUTERA

# --- Sign-in protection ---
# RUTERA_LOCKOUT_ATTEMPTS=5
# RUTERA_LOCKOUT_DURATION=15m
# RUTERA_PASSWORD_MIN_LENGTH=10

# --- Public API (AI access add-on): calls per token and minute ---
# RUTERA_API_RATE_PER_MINUTE=120

# --- Routing and geocoding (trip calculator, map) ---
# With "--profile routing": Valhalla in this stack.
# RUTERA_ROUTING_URL=http://valhalla:8002
# RUTERA_OSM_EXTRACT_URL=https://download.geofabrik.de/europe/poland-latest.osm.pbf
# RUTERA_ROUTING_THREADS=2
# The public Nominatim instance allows 1 request/s and wants a contact in the User-Agent; for heavy use run your own.
# RUTERA_GEOCODING_URL=https://nominatim.openstreetmap.org
# RUTERA_GEOCODING_USER_AGENT=RUTERA/1.0 (admin@example.com)

# --- Backups (backup service) ---
RUTERA_BACKUP_TIME=02:30
RUTERA_BACKUP_KEEP_DAYS=14
# Folder on the host, relative to this file
# RUTERA_BACKUP_DIR=./backups
