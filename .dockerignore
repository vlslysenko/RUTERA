# Build context of the Dockerfile: sources only. Dependencies and outputs are rebuilt inside the image.
.git
.gitignore
.idea
.vscode
.claude
**/*.iml
**/node_modules
**/target
**/dist
**/dev-dist
**/*.tsbuildinfo
logs
**/*.log
conf
docs
# Local settings and secrets (frontend/.env.local could switch the client to the mock API)
**/.env
**/.env.*
!.env.example
# Tachograph downloads and uploaded files hold personal data: never part of a build context
**/*.ddd
**/*.DDD
**/*.esm
**/*.ESM
**/*.tgd
**/*.TGD
**/*.c1b
**/*.C1B
**/*.v1b
**/*.V1B
tacho/samples-private
data
