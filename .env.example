# Copy to .env and adjust. Used by compose.yaml and (via environment) by the application.
RUTERA_DB_NAME=rutera
RUTERA_DB_USER=rutera
RUTERA_DB_PASSWORD=rutera
RUTERA_DB_ROOT_PASSWORD=root
RUTERA_DB_PORT=3306
# First start only: login and password of the initial owner account (standalone mode).
# If the password is empty, a random one is generated and printed in the log once.
RUTERA_BOOTSTRAP_ADMIN_LOGIN=admin
RUTERA_BOOTSTRAP_ADMIN_PASSWORD=
