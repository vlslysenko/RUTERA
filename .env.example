# Copy to .env and adjust. Read by compose.yaml; the rutera service passes the RUTERA_* values to the application.
# Without Docker the application takes the same names as environment variables.

# Port where RUTERA is reachable (compose publishes the container's 8080 there).
RUTERA_PORT=8080
# Image tag of the rutera service (docker compose build tags rutera:<tag>).
RUTERA_IMAGE_TAG=latest
# JVM options of the container (JAVA_TOOL_OPTIONS), e.g. -Xmx1g
RUTERA_JAVA_OPTS=
# true behind HTTPS (reverse proxy): the session cookie is then sent over HTTPS only.
RUTERA_COOKIE_SECURE=false

RUTERA_DB_NAME=rutera
RUTERA_DB_USER=rutera
RUTERA_DB_PASSWORD=rutera
RUTERA_DB_ROOT_PASSWORD=root
# Host port of MySQL for development (3306 is often taken by another MySQL).
RUTERA_DB_PORT=3307

# First start only (empty database, standalone mode): the first firma and its owner account.
# If the password is empty, a random one is generated and printed in the log once.
RUTERA_BOOTSTRAP_FIRMA_NAME=My company
RUTERA_BOOTSTRAP_FIRMA_COUNTRY=PL
RUTERA_BOOTSTRAP_LANG=en
RUTERA_BOOTSTRAP_ADMIN_LOGIN=admin
RUTERA_BOOTSTRAP_ADMIN_PASSWORD=
RUTERA_BOOTSTRAP_ADMIN_NAME=Administrator
# Login protection: failed attempts before a lock, and how long the lock lasts (Duration, e.g. 15m, 1h).
RUTERA_LOCKOUT_ATTEMPTS=5
RUTERA_LOCKOUT_DURATION=15m
